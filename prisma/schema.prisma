// Naman Enterprises — Prisma schema
// Source of truth: SRS §7. Update this file together with PROGRESS.md
// "Decisions log" whenever the data model changes.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7+: connection URLs live in `prisma.config.ts`. The runtime client
// is constructed with `@prisma/adapter-pg`, which reads `DATABASE_URL` from env
// directly. Migrate also reads from `prisma.config.ts`.
datasource db {
  provider = "postgresql"
}

// =============================================================================
// Users & Auth (Auth.js v5 standard tables + our extensions)
// =============================================================================

enum UserRole {
  GUEST
  CUSTOMER
  PREMIUM_CUSTOMER
  SELLER
  CUSTOMER_SUPPORT
  CATALOG_MANAGER
  MARKETING_MANAGER
  ORDER_MANAGER
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  isBlocked     Boolean   @default(false)
  lastLoginAt   DateTime?
  // Bumped by "log out everywhere" — JWTs minted with a stale tokenVersion are
  // rejected by `requireFreshSession()` on sensitive routes (account, checkout).
  tokenVersion  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts            Account[]
  sessions            Session[]
  addresses           Address[]
  carts               Cart[]
  wishlists           Wishlist[]
  orders              Order[]
  reviews             Review[]
  reviewVotes         ReviewVote[]
  qna                 QnA[]
  couponUsages        CouponUsage[]
  loyaltyTransactions LoyaltyTransaction[]
  notifications       Notification[]
  searchLogs          SearchLog[]
  auditLogs           AuditLog[]
  loginEvents         UserLoginEvent[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Successful sign-in audit. Drives the "Active sessions" list in the account
// dashboard. Not the auth source of truth (JWT cookie is) — purely a log.
// "Logout from all devices" bumps `User.tokenVersion` and writes a REVOKE row.
enum UserLoginEventKind {
  LOGIN
  LOGOUT
  REVOKE_ALL
}

model UserLoginEvent {
  id        String             @id @default(cuid())
  userId    String
  kind      UserLoginEventKind @default(LOGIN)
  provider  String? // "credentials" | "google" | ...
  ipAddress String?
  userAgent String?            @db.Text
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Short-lived (15 min) tokens issued by the forgot-password flow. The token
// stored here is the SHA-256 hash of the random secret emailed to the user;
// presenting the secret hashes back to this row.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
}

// =============================================================================
// Catalog
// =============================================================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  image       String?
  description String?  @db.Text
  seoTitle    String?
  seoDesc     String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?         @relation("CategoryToChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[]        @relation("CategoryToChildren")
  products ProductCategory[]

  @@index([parentId])
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?  @db.Text
  seoTitle    String?
  seoDesc     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  brandId         String?
  description     String        @db.Text
  shortDesc       String?
  status          ProductStatus @default(DRAFT)
  modelNumber     String?
  mpn             String?
  gtin            String?
  hsnCode         String?
  countryOfOrigin String        @default("India")
  warrantyType    String?
  warrantyMonths  Int?
  warrantyDocUrl  String?
  beeRating       Int?
  hazmatFlags     String[]      @default([])
  boxContents     String[]      @default([])
  seoTitle        String?
  seoDesc         String?
  searchVector    String?       @db.Text // populated by trigger on (name, description, brand)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  brand         Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories    ProductCategory[]
  variants      ProductVariant[]
  images        ProductImage[]
  specs         ProductSpec[]
  relatedFrom   RelatedProduct[]  @relation("RelatedFrom")
  relatedTo     RelatedProduct[]  @relation("RelatedTo")
  reviews       Review[]
  qna           QnA[]
  wishlistItems WishlistItem[]

  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  ean               String?
  name              String?
  attributes        Json     @default("{}") // { color: "Graphite", storage: "256GB", ram: "8GB" }
  mrp               Decimal  @db.Decimal(12, 2)
  price             Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  gstRate           Decimal  @default(18) @db.Decimal(5, 2)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  backorderAllowed  Boolean  @default(false)
  weightGrams       Int?
  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  isDefault         Boolean  @default(false)
  position          Int      @default(0)
  version           Int      @default(0) // optimistic concurrency for stock decrement
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([stock])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
}

model ProductSpec {
  id        String @id @default(cuid())
  productId String
  group     String // "Display", "Battery", "Camera"
  key       String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, group])
}

enum ProductAttributeType {
  TEXT
  COLOR
  STORAGE
  SIZE
  RAM
  NUMBER
  BOOLEAN
}

model ProductAttribute {
  id      String               @id @default(cuid())
  name    String               @unique
  type    ProductAttributeType
  options String[]             @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RelatedProductType {
  SIMILAR
  COMPATIBLE
  BUNDLE
  ACCESSORY
}

model RelatedProduct {
  id        String             @id @default(cuid())
  productId String
  relatedId String
  type      RelatedProductType
  position  Int                @default(0)

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, type])
  @@index([relatedId])
}

// =============================================================================
// Inventory
// =============================================================================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("IN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  warehouseId String
  type        StockMovementType
  quantity    Int
  reason      String?
  refType     String? // "Order", "Return", "Manual"
  refId       String?
  createdAt   DateTime          @default(now())
  createdBy   String?

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([warehouseId])
}

// =============================================================================
// Cart & Wishlist
// =============================================================================

model Cart {
  id        String    @id @default(cuid())
  userId    String?
  sessionId String?   @unique
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     CartItem[]
  reminders CartReminder[]

  @@index([userId])
}

// One row per (cart, tier) to track abandonment reminder emails sent.
// Tier semantics: 1 = 1h, 2 = 24h, 3 = 72h. The unique constraint enforces
// "at most one email per tier per cart, ever" — Phase-2 will graduate to
// per-abandonment-cycle reminders.
model CartReminder {
  id     String   @id @default(cuid())
  cartId String
  tier   Int
  sentAt DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, tier])
  @@index([sentAt])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  variantId     String
  quantity      Int      @default(1)
  priceSnapshot Decimal  @db.Decimal(12, 2)
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Wishlist")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
}

// =============================================================================
// Orders
// =============================================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_PICKED_UP
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentChannel {
  WEB
  MOBILE_WEB
  ADMIN
  API
}

model Order {
  id            String             @id @default(cuid())
  orderNumber   String             @unique
  userId        String?
  email         String
  phone         String
  status        OrderStatus        @default(PENDING)
  paymentStatus PaymentStatus      @default(PENDING)
  channel       FulfillmentChannel @default(WEB)
  subtotal      Decimal            @db.Decimal(12, 2)
  taxTotal      Decimal            @db.Decimal(12, 2)
  shippingTotal Decimal            @default(0) @db.Decimal(12, 2)
  discountTotal Decimal            @default(0) @db.Decimal(12, 2)
  codFee        Decimal            @default(0) @db.Decimal(12, 2)
  total         Decimal            @db.Decimal(12, 2)
  currency      String             @default("INR")
  notes         String?            @db.Text
  giftMessage   String?
  giftWrap      Boolean            @default(false)
  isGstInvoice  Boolean            @default(false)
  gstin         String?
  cancelReason  String?
  cancelledAt   DateTime?
  placedAt      DateTime           @default(now())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  addresses    OrderAddress[]
  events       OrderEvent[]
  shipments    Shipment[]
  payments     Payment[]
  refunds      Refund[]
  returns      Return[]
  couponUsages CouponUsage[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([deletedAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  variantId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  taxAmount       Decimal @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2)
  productSnapshot Json // { name, sku, slug, image, brand, attributes, hsn, gstRate }

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

enum AddressType {
  BILLING
  SHIPPING
}

model OrderAddress {
  id       String      @id @default(cuid())
  orderId  String
  type     AddressType
  fullName String
  phone    String
  line1    String
  line2    String?
  city     String
  state    String
  pincode  String
  country  String      @default("IN")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  createdBy String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_INITIATED
  RETURN_PICKED_UP
  RETURNED_TO_ORIGIN
  EXCEPTION
}

model Shipment {
  id            String         @id @default(cuid())
  orderId       String
  carrier       String
  awb           String?        @unique
  trackingUrl   String?
  status        ShipmentStatus @default(CREATED)
  estimatedDate DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  weightGrams   Int?
  packageCount  Int            @default(1)
  raw           Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// =============================================================================
// Payments
// =============================================================================

enum PaymentGateway {
  RAZORPAY
  COD // not a real gateway, but tracked here for COD orders
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  EMI
  PAY_LATER
  COD
}

model Payment {
  id               String         @id @default(cuid())
  orderId          String
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayOrderId   String?
  gatewayPaymentId String?        @unique // Razorpay payment_id — unique stops double-processing
  gatewaySignature String?
  method           PaymentMethod?
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  status           PaymentStatus  @default(PENDING)
  errorCode        String?
  errorDescription String?
  raw              Json?
  capturedAt       DateTime?
  failedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([status])
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  paymentId       String
  amount          Decimal      @db.Decimal(12, 2)
  reason          String?
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @unique
  raw             Json?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
}

// =============================================================================
// Returns
// =============================================================================

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUNDED
  CANCELLED
}

enum ReturnReason {
  WRONG_ITEM
  DAMAGED
  DEFECTIVE
  NOT_AS_DESCRIBED
  CHANGED_MIND
  BETTER_PRICE_AVAILABLE
  OTHER
}

model Return {
  id            String       @id @default(cuid())
  orderId       String
  reason        ReturnReason
  status        ReturnStatus @default(REQUESTED)
  pickupNote    String?      @db.Text
  pickupAddress Json?
  refundAmount  Decimal?     @db.Decimal(12, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([orderId])
  @@index([status])
}

enum ItemCondition {
  UNUSED
  USED
  DAMAGED
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  condition   ItemCondition @default(UNUSED)

  return    Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
}

// =============================================================================
// Reviews & Q&A
// =============================================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int // 1-5
  title     String?
  body      String       @db.Text
  status    ReviewStatus @default(PENDING)
  helpful   Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   ReviewMedia[]
  votes   ReviewVote[]

  @@unique([productId, userId, orderId])
  @@index([productId, status])
  @@index([userId])
}

enum ReviewMediaType {
  IMAGE
  VIDEO
}

model ReviewMedia {
  id       String          @id @default(cuid())
  reviewId String
  type     ReviewMediaType
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

enum QnAStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model QnA {
  id           String    @id @default(cuid())
  productId    String
  userId       String
  question     String    @db.Text
  answer       String?   @db.Text
  answeredById String?
  answeredAt   DateTime?
  status       QnAStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([userId])
}

// =============================================================================
// Marketing — Coupons, Banners, Loyalty
// =============================================================================

enum CouponType {
  PERCENTAGE
  FLAT
  FREE_SHIPPING
  BOGO
  GIFT
  CASHBACK
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  description     String?    @db.Text
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minOrderValue   Decimal?   @db.Decimal(12, 2)
  maxDiscount     Decimal?   @db.Decimal(12, 2)
  rules           Json       @default("{}") // { categoryIds, brandIds, productIds, segments, firstOrderOnly }
  perUserLimit    Int?
  totalUsageLimit Int?
  usageCount      Int        @default(0)
  isStackable     Boolean    @default(false)
  isAutoApply     Boolean    @default(false)
  validFrom       DateTime
  validTo         DateTime
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  usages CouponUsage[]

  @@index([validFrom, validTo])
  @@index([isActive])
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  orderId       String?
  discountValue Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

enum BannerPosition {
  HOMEPAGE_HERO
  HOMEPAGE_STRIP
  CATEGORY_HERO
  PDP_BANNER
  CART_BANNER
}

model Banner {
  id        String         @id @default(cuid())
  position  BannerPosition
  title     String
  subtitle  String?
  image     String
  imageAlt  String
  link      String?
  validFrom DateTime
  validTo   DateTime
  priority  Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([position, isActive])
  @@index([validFrom, validTo])
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUSTMENT
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  userId    String
  type      LoyaltyTransactionType
  points    Int
  refType   String?
  refId     String?
  note      String?
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// =============================================================================
// Misc — Notifications, Search log, Audit log, Settings
// =============================================================================

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  PROMOTION
  ACCOUNT
  REVIEW
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model SearchLog {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?
  query            String
  resultsCount     Int
  clickedProductId String?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
