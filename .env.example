# =============================================================================
# .env.example — copy to .env.local and fill in real values for local dev.
# Production / preview / staging values live in Vercel Environment Variables.
# This file is the only env file committed to git. Never commit .env.local.
# =============================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Naman Electronics"
NODE_ENV="development"

# ---- Compliance / store identity (rendered on legal pages) ----
# Required before launch — the legal pages render visible placeholder text
# whenever any of these are unset, so a missed value never silently ships.
STORE_LEGAL_NAME=""
STORE_REGISTERED_ADDRESS=""
STORE_GSTIN=""
STORE_CIN=""
SUPPORT_EMAIL=""
SUPPORT_PHONE=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_EMAIL=""
GRIEVANCE_OFFICER_DESIGNATION="Grievance Officer"

# ---- Database (Neon Postgres) ----
# Pooled connection (used by the app at runtime).
DATABASE_URL=""
# Direct (non-pooled) connection — required by Prisma migrate.
DIRECT_URL=""

# ---- Auth.js v5 ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Trust the host header in dev (and behind a reverse proxy).
AUTH_TRUST_HOST="true"

# ---- OAuth Providers ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Razorpay (sole payment gateway) ----
# Test mode for local + preview/staging. Live mode ONLY in production env vars.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Resend (transactional email) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@example.com"

# ---- Cloudinary (product media) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ---- MSG91 (SMS / WhatsApp / OTP — India) ----
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# ---- Upstash Redis (rate limiting, hot cache) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Upstash QStash (background jobs, optional in Phase 1) ----
QSTASH_URL=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ---- Cron auth (Vercel Cron / QStash) ----
# Shared secret sent as `Authorization: Bearer ${CRON_SECRET}` to /api/cron/*.
# Vercel Cron auto-injects this header if CRON_SECRET is set in the project
# env vars. For QStash, include the header in the schedule's request config.
# In dev (unset), /api/cron/cart-abandonment runs without auth for local testing.
CRON_SECRET=""

# ---- Sentry ----
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ---- PostHog (product analytics) ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Cloudflare Turnstile (bot protection) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Shipping (Shiprocket) ----
# Login email + password for the Shiprocket *API user* (not your dashboard
# login). Settings → API → Add New API User on the Shiprocket dashboard
# generates these. The runtime caches the bearer token in memory and
# refreshes on 401.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
# Optional bootstrap token for non-runtime scripts; the runtime mints its own.
SHIPROCKET_TOKEN=""
# Pickup location nickname configured on Settings → Pickup Addresses.
# Defaults to "Primary" — override only if you've renamed it.
SHIPROCKET_PICKUP_LOCATION="Primary"
# Security token configured on Settings → API → Webhooks → Security Token.
# Compared to the `x-api-key` header on /api/webhooks/shiprocket. Generate
# via `openssl rand -base64 32`. In dev, leaving this unset accepts unsigned
# webhooks for local testing.
SHIPROCKET_WEBHOOK_TOKEN=""

# ---- Inventory ----
# Code of the warehouse used as the StockMovement origin/destination on
# order placement and cancellation. The seed creates a "DEFAULT" warehouse;
# override only if you rename it or add multi-warehouse routing.
DEFAULT_WAREHOUSE_CODE="DEFAULT"

# ---- Google Analytics 4 / GTM ----
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# ---- Microsoft Clarity ----
NEXT_PUBLIC_CLARITY_PROJECT_ID=""

# ---- HIBP (pwned-passwords check, optional) ----
HIBP_USER_AGENT="naman-ent"

# ---- India Post pincode lookup ----
INDIA_POST_API_URL="https://api.postalpincode.in"

# ---- Algolia / Meilisearch (Phase 2) ----
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=""
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=""
